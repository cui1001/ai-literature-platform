# ============================================================
# AgentLit 科研助手 —— 环境变量样例
# 复制为 backend/.env 后按需填写。全部留空时系统进入「离线确定性模式」，
# 六大模块依然可完整演示（检索、抽取、图谱、综述、绘图均由本地算法完成）。
# ============================================================

# ----- 应用 -----
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
# 数据目录（SQLite、页面图、解析产物），默认 backend/data
DATA_DIR=./data

# ----- 大模型通道 -----
# auto   : 有密钥且网络可用则走在线，否则自动降级离线（推荐）
# online : 强制在线，失败直接报错
# offline: 强制离线确定性引擎
LLM_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ----- 向量化通道 -----
# auto / online / offline
EMBED_MODE=auto
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ----- arXiv / 学术检索 -----
# auto / online / offline（offline 使用 fixtures 内置语料，保证无网可演示）
ARXIV_MODE=auto
ARXIV_MAX_RESULTS=20
# 追踪刷新间隔（分钟），前端可手动触发
TRACKER_INTERVAL_MINUTES=360

# ----- 解析参数 -----
# 页面渲染 DPI（越大越清晰、越慢）
PAGE_RENDER_DPI=150
# 触发 OCR 的文本密度阈值（每页字符数低于该值视为扫描页）
OCR_TEXT_THRESHOLD=40
